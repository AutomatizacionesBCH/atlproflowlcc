# Mismo proyecto Supabase que ProFlow OS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KYC (Didit) — solo servidor
DIDIT_API_KEY=
KYC_LIVENESS_MIN=60
KYC_FACE_MATCH_MIN=60

# Captcha del login (Cloudflare Turnstile). Opcional en desarrollo; activar también en Supabase → Auth → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Aviso por correo al equipo cuando entra una solicitud (Gmail con contraseña de aplicación)
GMAIL_USER=
GMAIL_APP_PASSWORD=
TEAM_NOTIFY_EMAILS=
APP_URL=https://tu-app.example.com

# MODO PRUEBAS: permite a los administradores marcar su cuenta como verificada sin Didit. Dejar vacío o en false en producción real.
ENABLE_KYC_TEST_MODE=false
